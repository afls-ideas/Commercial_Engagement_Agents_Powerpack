<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>PP Event Brief</masterLabel>
    <description>Renders the PP Event Brief custom Lightning type: an existing event with speakers, attendees and earlier-event attendance history.</description>
    <targets>
        <target>lightning__AgentforceOutput</target>
        <target>lightning__UrlAddressable</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AgentforceOutput">
            <sourceType name="c__ppEventBrief"/>
            <supportedFormFactors>
                <supportedFormFactor type="Small"/>
                <supportedFormFactor type="Large"/>
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
